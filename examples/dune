; Examples are built with the rest of the project (and so in CI) but not installed.
; Their output is checked by the runtest alias.

(executable
 (name passkey_flow)
 (libraries core async webauthn webauthn.testing yojson)
 (preprocess
  (pps ppx_jane)))

(rule
 (alias runtest)
 (action
  (progn
   (with-stdout-to
    passkey_flow.output
    (run %{exe:passkey_flow.exe}))
   (diff passkey_flow.expected passkey_flow.output))))
